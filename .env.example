# ─── resy-rank (read-only scanner/ranker) ───────────────────────────────────
# Resy's public web API key — the same value resy.com sends from any browser,
# logged in or not. Availability lookups appear to need nothing else.
RESY_API_KEY=VbWk7s3L4KiK5fzlO7JD3Q5EYolJI7n5

# Optional. Only set this if a request comes back 401/403. Grab it from
# DevTools → Network → any api.resy.com request → Request Headers →
# X-Resy-Auth-Token. It is your personal session token: treat it like a
# password, and never commit it.
RESY_AUTH_TOKEN=

# Google Places API (New). Requesting `rating` bills at the Enterprise SKU,
# so results are cached in SQLite for GOOGLE_CACHE_DAYS.
GOOGLE_PLACES_API_KEY=
GOOGLE_CACHE_DAYS=180
# Enterprise-SKU calls per calendar month. The default equals Google's free
# tier, so enrichment costs nothing until you deliberately raise it.
MONTHLY_ENRICHMENT_CAP=1000

# Geo sweep anchor points, "lat,long;lat,long;...". The default nine cover
# Manhattan. One request per anchor per date beats one per venue by ~200x.
# GEO_ANCHORS=40.7075,-74.0113;40.7549,-73.9840
GEO_PER_PAGE=50
GEO_MAX_PAGES=10

# Politeness — hard caps on how hard this tool hits Resy. Raise at your peril.
MAX_CONCURRENCY=3
REQUEST_DELAY_SECONDS=1.5
DAILY_REQUEST_CAP=750

# Scoring weights (need not sum to 1; they are normalized).
WEIGHT_RATING=0.35
WEIGHT_CRITIC=0.35
WEIGHT_SCARCITY=0.30

# Bayesian prior weight `m` — how many average-rated reviews a venue is
# charged before its own rating counts at full strength.
BAYESIAN_PRIOR_WEIGHT=300

# Scarcity index: prime = Thu–Sat 18:30–20:30, observed 14–28 days out.
PRIME_DAYS=thu,fri,sat
SCARCITY_LOOKBACK_DAYS=30
SCARCITY_MIN_OBSERVATIONS=20

# Critic name matching (rapidfuzz score 0–100).
CRITIC_MATCH_THRESHOLD=88

# ─── legacy auto-booker (main.py / booker.py) ───────────────────────────────
# Unrelated to resy-rank, which never authenticates with a password and never
# books anything.
RESY_EMAIL=your@email.com
RESY_PASSWORD=yourpassword

NOTIFY_EMAIL_TO=you@email.com
NOTIFY_SMTP_HOST=smtp.gmail.com
NOTIFY_SMTP_PORT=587
NOTIFY_SMTP_USER=you@gmail.com
NOTIFY_SMTP_PASS=your_app_password
