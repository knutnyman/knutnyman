# ── Resy auto-booker ─────────────────────────────────────────────────────────
RESY_EMAIL=your@email.com
RESY_PASSWORD=yourpassword

# ── Dexcom sentiment tracker ─────────────────────────────────────────────────

# Reddit — no API key needed, uses public JSON feed
# Subreddits to monitor (comma-separated). Non-dexcom subs are filtered to
# posts mentioning Dexcom keywords automatically.
# Default: dexcom,diabetes,diabetes_t1,diabetes_t2,CGM
DEXCOM_SUBREDDITS=dexcom,diabetes,diabetes_t1,diabetes_t2,CGM

# Facebook group scraping (Selenium — use at own risk, against FB ToS)
FACEBOOK_EMAIL=you@email.com
FACEBOOK_PASSWORD=yourpassword
# Comma-separated list of Facebook group URLs to scrape
FACEBOOK_GROUP_URLS=https://www.facebook.com/groups/dexcomusers,https://www.facebook.com/groups/diabetestechnology

# How far back to pull posts (hours). Default: 24
SENTIMENT_HOURS_BACK=24

# ── Email notifications (all optional — omit to print digest to stdout) ──────
NOTIFY_EMAIL_TO=you@email.com
NOTIFY_SMTP_HOST=smtp.gmail.com
NOTIFY_SMTP_PORT=587
NOTIFY_SMTP_USER=you@gmail.com
NOTIFY_SMTP_PASS=your_app_password
